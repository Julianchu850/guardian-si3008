# Copia este archivo como .env y ajústalo.

# IP pública de la EC2 (la escribe ./set-host.sh). Cambia cada vez que se
# reinicia la sesión del Learner Lab.
KAFKA_ADVERTISED_HOST=localhost

# Destino de la capa bronce: s3://<tu-bucket>/<prefijo>  o  /data/lake para modo local
BRONZE_URI=s3://<tu-bucket>/guardian

FLUSH_MAX_RECORDS=5000
FLUSH_MAX_SECONDS=60
AWS_DEFAULT_REGION=us-east-1
