# Lo crea ./init-env.sh a partir de este archivo. Edita al menos GUARDIAN_LAKE.

# Raíz del data lake (el mismo bucket y prefijo que BRONZE_URI en infra/kafka/.env)
GUARDIAN_LAKE=s3://<tu-bucket>/guardian

# Carpeta del host compartida con el simulador (corridas, dimensiones y verdad terreno)
GUARDIAN_DATA=/home/ec2-user/guardian-data

# EMR: usa la misma versión y tipo de instancia que les funcionó en los laboratorios
EMR_RELEASE=emr-7.2.0
EMR_INSTANCE_TYPE=m5.xlarge
EMR_CORE_COUNT=2
EMR_SUBNET=
EMR_KEY=vockey
AWS_DEFAULT_REGION=us-east-1

# Acceso a la UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__CAMBIAR__

# Claves internas (init-env.sh las genera)
AIRFLOW_UID=50000
AIRFLOW_JWT_SECRET=__GENERAR__
AIRFLOW_FERNET_KEY=
